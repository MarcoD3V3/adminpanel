{
  "name": "craftlauncher-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "electron:dev": "node scripts/free-port.mjs 1420 && concurrently -k \"vite\" \"wait-on http://localhost:1420 && nodemon --watch electron --ext mjs --exec electron .\"",
    "electron:dev:prod": "node scripts/run-electron-dev.mjs --prod-api",
    "electron:build": "node scripts/write-app-config.mjs && node scripts/clean-release.mjs && npm run build && electron-builder --win"
  },
  "dependencies": {
    "@craftlauncher/shared": "*",
    "clsx": "^2.1.1",
    "lucide-react": "^0.511.0",
    "minecraft-launcher-core": "^3.18.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.0",
    "concurrently": "^9.1.2",
    "electron": "35.7.5",
    "electron-builder": "^25.1.8",
    "nodemon": "^3.1.14",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "wait-on": "^8.0.3"
  },
  "build": {
    "electronVersion": "35.7.5",
    "appId": "com.craftlauncher.app",
    "productName": "CraftLauncher",
    "directories": {
      "output": "release-out"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "electron/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
