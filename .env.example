# Clave admin + firma digital de layouts del hub (mín. 16 caracteres en producción)
LAUNCHER_ADMIN_SECRET=cambia-esto-por-una-clave-larga-y-secreta

# Pepper para hashear tokens en servidor (mín. 16 caracteres; distinto de LAUNCHER_ADMIN_SECRET)
LAUNCHER_TOKEN_PEPPER=                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   

# false = desactiva la exigencia de sesión en /api/hub-builder (solo desarrollo)
LAUNCHER_AUTH_ENFORCE=true

# Origen del launcher para CORS (Electron dev usa localhost:1420)
LAUNCHER_ORIGIN=http://localhost:1420

# --- Launcher (Vite / Electron) — leído desde packages/launcher ---
# Admin en producción (prioridad). Pon tu URL de Railway aquí:
# VITE_ADMIN_API_URL=https://tu-app.up.railway.app
# Admin local si producción no responde (npm run dev en otra terminal):
# VITE_ADMIN_API_URL_LOCAL=http://localhost:3000

# CurseForge API — token desde https://console.curseforge.com → API Keys
# Suele empezar por $2a$10$ — sin comillas. Reinicia npm run dev y launcher:dev tras cambiarlo.
CURSEFORGE_API_KEY=
